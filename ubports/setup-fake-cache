#!/system/bin/sh

exit_mounted() {
    setprop halium.datamount.done 1
    exit $1
}

case "$(getprop ro.ubuntu.recovery.fakecache)" in
true|1) : ;;
*) exit_mounted 0 ;;
esac

# Try to activate an LVM VG on userdata; use it if exists, otherwise
# fall back to the raw partition (not yet migrated, or LVM not in use)
vgchange -ay ubports > /dev/kmsg 2>&1 || true
if [ -e /dev/ubports/userdata ]; then
    MOUNT_DEV=/dev/ubports/userdata
else
    MOUNT_DEV=/dev/block/by-name/userdata
fi

# Idempotent: recovery re-runs this after the LVM migration, when /data
# and/or /cache may already be mounted.
already_mounted() {
    grep -q "^[^ ]* $1 " /proc/mounts
}

RETRY_COUNTER=0
while [ $(( RETRY_COUNTER += 1 )) -le 3 ]; do
    already_mounted /data && break
    mount "$MOUNT_DEV" /data > /dev/kmsg && break || sleep 1
done

if [ $RETRY_COUNTER -eq 4 ]; then
    echo "setup-fake-cache: reached maximum number of retries for $MOUNT_DEV" > /dev/kmsg
    exit_mounted 1
fi

if ! already_mounted /cache; then
    mkdir -p /data/cache > /dev/kmsg
    mount -o bind /data/cache /cache > /dev/kmsg
fi
exit_mounted 0
